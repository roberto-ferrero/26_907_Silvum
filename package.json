{
  "name": "silvum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulador 3D de crecimiento y morfología de árboles con three.js y WebGPU.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "vitest run tests/bench.test.ts --mode bench --silent=false --reporter=verbose"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/three": "0.186.0",
    "eslint": "9.39.1",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
